  "subject": "judgement",
  "tags": [
    "offline",
    "no-ai",
    "attribution",
    "mutation",
    "h6",
    "hard-tier"
  ],
  "kind": "pipeline",
  "requires": {
    "platforms": ["win32"],
    "tools": [
      "git",
      "cmake",
      "ninja",
      "gcc"
    ],
    "recipe": "win-mingw-ninja-debug"
  },
  "prepare": "prepare.ts",
  "repo": ".",
  "task": "resources/tasks/h6-loop.task.txt",
  "stages": {
    "workflows": {
      "mode": "preset",
      "resource": "workflows/judgement-hard"
    },
    "refactor": {
      "mode": "patch",
