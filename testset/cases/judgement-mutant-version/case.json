{
  "id": "judgement-mutant-version",
  "title": "行为变异（uv_version() 常量被改）必须 REJECTED",
  "subject": "judgement",
  "tags": [
    "offline",
    "no-ai",
    "attribution",
    "mutation"
  ],
  "kind": "pipeline",
  "requires": {
    "tools": [
      "git",
      "cmake",
      "ninja",
      "gcc"
    ],
    "recipe": "win-mingw-ninja-debug"
  },
  "prepare": "prepare.ts",
  "repo": ".",
  "task": "resources/tasks/t1-strtok.task.txt",
  "stages": {
    "workflows": {
      "mode": "preset",
      "resource": "workflows/judgement"
    },
    "refactor": {
      "mode": "patch",
      "patchFile": "resources/patches/mutant-version-hex.patch"
    }
  },
  "expect": {
    "method": "verdict+attribution",
    "state": "REJECTED",
    "failuresRequired": [
      "oracle_version.exit",
      "oracle_version.summary",
      "oracle_version.stdout"
    ],
    "provisional": false,
    "note": "实测冻结（2026-09-15，3 条失配） — 原预测：期望失配集为预测值（按 oracle 覆盖推断），首次跑用 --calibrate 冻结精确集",
    "injectedStages": [
      "workflows",
      "refactor"
    ],
    "authoritative": true,
    "failuresExact": [
      "oracle_version.exit",
      "oracle_version.stdout",
      "oracle_version.summary"
    ]
  },
  "inject": [
    {
      "source": "resources/judge/libuv-1.52.1/oracle",
      "dest": "refactor-task/oracle"
    }
  ]
}
