{
  "id": "judgement-mutant-h7-threadpool",
  "title": "H7 变异（取消判据/标记时序被改动）必须 REJECTED",
  "subject": "judgement",
  "tags": [
    "offline",
    "no-ai",
    "attribution",
    "mutation",
    "h7",
    "hard-tier"
  ],
  "kind": "pipeline",
  "requires": {
    "tools": [
      "git",
      "cmake",
      "ninja",
      "gcc"
    ],
    "recipe": "libuv-ninja-debug"
  },
  "prepare": "prepare.ts",
  "repo": ".",
  "task": "resources/tasks/h7-threadpool.task.txt",
  "stages": {
    "workflows": {
      "mode": "preset",
      "resource": "workflows/judgement-hard"
    },
    "refactor": {
      "mode": "patch",
      "patchFile": "resources/patches/mutant-h7-threadpool.patch"
    }
  },
  "expect": {
    "method": "verdict+attribution",
    "state": "REJECTED",
    "failuresRequired": [
      "h7-threadpool/oracle_threadpool.exit",
      "h7-threadpool/oracle_threadpool.summary",
      "h7-threadpool/oracle_threadpool.stdout"
    ],
    "injectedStages": [
      "workflows",
      "refactor"
    ],
    "authoritative": true,
    "provisional": false,
    "note": "实测冻结（2026-09-21，6 条失配） — failuresRequired 钉住 oracle 三件套；共享判据下同一变异可能同时触发别的目标 oracle（h6 变异也触发 h4-walk oracle），失配集不是单目标归因",
    "failuresExact": [
      "h6-loop/oracle_loop.exit",
      "h6-loop/oracle_loop.stdout",
      "h6-loop/oracle_loop.summary",
      "h7-threadpool/oracle_threadpool.exit",
      "h7-threadpool/oracle_threadpool.stdout",
      "h7-threadpool/oracle_threadpool.summary"
    ]
  },
  "inject": [
    {
      "source": "resources/judge/libuv-1.52.1-hard",
      "dest": "refactor-task/oracle-hard"
    }
  ],
  "timeoutMs": 3600000
}
